# Server only. Never use these values in Android/Gradle resources.
TITAN_ENVIRONMENT=development
TITAN_DATABASE_URL=sqlite+aiosqlite:///./data/titan.db
# Required in production:
# TITAN_API_KEY=replace-with-a-long-random-server-secret
# TITAN_OPENAI_COMPATIBLE_BASE_URL=https://your-provider.example/v1
# TITAN_OPENAI_COMPATIBLE_API_KEY=server-side-secret
# TITAN_OPENAI_COMPATIBLE_MODEL=verified-model-id
# TITAN_GITHUB_TOKEN=optional-server-side-github-token
